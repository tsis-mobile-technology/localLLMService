# Local LLM Platform Environment Configuration Example
# Copy this file to .env and adjust as needed:
# cp .env.example .env

# PostgreSQL Database Configuration
POSTGRES_DB=litellm
POSTGRES_USER=llm_admin
POSTGRES_PASSWORD=llm_secret_pass

# Database Connection URLs
DATABASE_URL=postgresql://llm_admin:llm_secret_pass@litellm-postgres:5432/litellm
HOST_DATABASE_URL=postgresql://llm_admin:llm_secret_pass@localhost:5432/litellm

# LiteLLM Master API Key
LITELLM_MASTER_KEY=sk-local-master

# Local Model Storage Directory
MODELS_DIR=/home/taejonggo/Projects/models
